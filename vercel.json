{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ui && npm ci",
  "buildCommand": "cd ui && npm run build",
  "outputDirectory": "ui/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://digital-brain-api-production.up.railway.app/:path*"
    }
  ]
}
